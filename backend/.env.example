# Server
PORT=4000
FRONTEND_ORIGIN=https://your-domain-on-hostinger.com

# Postgres (docker-compose service name "db" if using the provided compose file)
DATABASE_URL=postgresql://vastu:vastu@db:5432/vastu?schema=public

# Admin API access (for GET /api/leads)
ADMIN_TOKEN=change-this-to-a-long-random-string

# Razorpay (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MASTERCLASS_PRICE_PAISE=9900

# MSG91 WhatsApp (from MSG91 dashboard > WhatsApp)
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=shri_v_m_joshi
MASTERCLASS_EVENT_DATETIME=07/08/2026, 8:00 PM
# Optional: switch to an image-header template (e.g. Sachin's photo) once
# one is created and approved in MSG91. Set both vars together; leave both
# blank to keep using the safe text-only template 1 above.
# MSG91_WHATSAPP_TEMPLATE_NAME=<template-2-name>
MSG91_WHATSAPP_HEADER_IMAGE_URL=
# Optional: template 3 ("welcome" variant - Joshi Institute branded image,
# different body text, single {{1}} name variable, static "Join Community"
# button baked into the template). Set all three of these together; leave
# MSG91_WHATSAPP_TEMPLATE_VARIANT unset to keep template 1/2 behavior.
# MSG91_WHATSAPP_TEMPLATE_NAME=<template-3-name>
# MSG91_WHATSAPP_HEADER_IMAGE_URL=<template-3-image-url>
MSG91_WHATSAPP_TEMPLATE_VARIANT=

# Auto payment-reminder (fires ~2 min after a lead registers if still
# unpaid, with a personalized Razorpay Payment Link). Leave the template
# name blank to keep the reminder job disabled (it no-ops with no env set).
MSG91_WHATSAPP_REMINDER_TEMPLATE_NAME=vastu_payment_reminder_99_2min
MSG91_WHATSAPP_REMINDER_HEADER_IMAGE_URL=

# Google Sheets mirror via Apps Script Web App (see backend/README.md)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
